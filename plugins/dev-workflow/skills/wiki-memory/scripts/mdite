#!/usr/bin/env bash
# mdite — pinned npx passthrough wrapper for mdite@1.1.0
#
# Usage: mdite <args>
#
# Wraps `timeout 30 npx --yes mdite@1.1.0 <args>` and remaps its exit code so
# a network hiccup or stalled fetch never reads as a clean wiki. mdite itself
# exits 1 natively on validation findings (not 0 — mdite commands.md: 0=no
# errors, 1=validation errors, 2=invalid arguments, 130=interrupted), so a
# bare passthrough would misreport findings as a wrapper failure and could
# hide a genuine "tool unavailable" behind that same non-zero code. This
# wrapper instead captures the underlying exit code + stdout and classifies:
#
#   1. timeout's own exit 124                  -> EX_UNAVAILABLE, unconditional
#                                                  on stdout content (a stalled
#                                                  fetch always degrades, even
#                                                  if partial output leaked
#                                                  before the kill)
#   2. underlying exit 0                       -> wrapper exit 0 (clean or
#                                                  0-exit output, forwarded)
#   3. other non-zero + non-empty stdout       -> wrapper exit 0, findings
#                                                  forwarded unchanged (covers
#                                                  mdite's real exit-1-on-
#                                                  findings behavior)
#   4. other non-zero + EMPTY stdout           -> EX_UNAVAILABLE (genuine
#                                                  npx/network failure)
#
# SIGINT/SIGTERM while running cancel the in-flight fetch, leave no orphaned
# child, and surface as exit 130/143 — distinct from EX_UNAVAILABLE, so an
# interrupt is never misreported as a network/timeout outcome.
#
# Argument guard is scoped: ONLY -h/--help is wrapper-owned. Every other
# token (lint, deps, files, --entrypoint, --config, --orphans, etc.) belongs
# to mdite's own grammar and passes through to npx unexamined — this wrapper
# does not maintain a copy of mdite's flags.

set -euo pipefail

EX_UNAVAILABLE=69

case "${1:-}" in
  -h|--help)
    cat <<'USAGE'
Usage: mdite <args>

Pinned passthrough wrapper for mdite@1.1.0 (fetched via `npx --yes`, bounded
by a 30s timeout). All arguments other than -h/--help pass through to mdite
unexamined.

Exit codes:
  0    mdite ran — clean, or findings forwarded on stdout (remaps mdite's
       native exit-1-on-findings)
  130  interrupted (SIGINT)
  143  interrupted (SIGTERM)
  69   EX_UNAVAILABLE — npx/network failure or the 30s timeout elapsed;
       treat as "integrity check skipped", never "verified clean"
USAGE
    exit 0
    ;;
esac

_out_tmp="$(mktemp)"
_child_pid=""
_sig_received=""

_cleanup() {
  rm -f "$_out_tmp"
}
trap _cleanup EXIT

# Forward an incoming signal to the in-flight `timeout` child so it (and the
# npx/mdite process tree beneath it) never survives past the wrapper. Always
# forward as TERM regardless of which signal we received: a background job
# (`&`) started by a non-interactive script has SIGINT/SIGQUIT dispositions
# set to ignored by bash convention, so forwarding INT would silently no-op
# — TERM is not subject to that auto-ignore and reliably reaches `timeout`,
# which in turn propagates it to npx.
_forward_signal() {
  local sig="$1"
  _sig_received="$sig"
  if [[ -n "$_child_pid" ]]; then
    kill -TERM "$_child_pid" 2>/dev/null || true
  fi
}
trap '_forward_signal INT' INT
trap '_forward_signal TERM' TERM

timeout 30 npx --yes mdite@1.1.0 "$@" >"$_out_tmp" &
_child_pid=$!

set +e
while true; do
  wait "$_child_pid"
  _rc=$?
  # A trapped signal can interrupt `wait` before the child has actually
  # exited; keep waiting on the same pid until it's truly gone so we never
  # act on a phantom status or return while the child is still alive.
  kill -0 "$_child_pid" 2>/dev/null || break
done
set -e

if [[ -n "$_sig_received" ]]; then
  case "$_sig_received" in
    INT) exit 130 ;;
    TERM) exit 143 ;;
  esac
fi

if [[ "$_rc" -eq 0 ]]; then
  cat "$_out_tmp"
  exit 0
fi

if [[ "$_rc" -eq 124 ]]; then
  # timeout's own expiry code — always unavailable, regardless of any
  # partial stdout produced before the kill.
  echo "ERROR: mdite unavailable (30s timeout elapsed) — integrity check skipped, not verified clean" >&2
  exit "$EX_UNAVAILABLE"
fi

if [[ -s "$_out_tmp" ]]; then
  # Non-zero underlying exit WITH stdout content — mdite ran and produced
  # findings (the leg that captures mdite's real exit-1-on-findings
  # behavior). Remap to 0, forward stdout unchanged.
  cat "$_out_tmp"
  exit 0
fi

# Non-zero underlying exit with EMPTY stdout — genuinely unavailable
# (npx/network failure).
echo "ERROR: mdite unavailable (npx/network failure) — integrity check skipped, not verified clean" >&2
exit "$EX_UNAVAILABLE"
